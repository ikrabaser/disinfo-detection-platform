# Django
DJANGO_SECRET_KEY=insecure-dev-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Veritabani (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dezenformasyon_db

# JWT / cookie
JWT_COOKIE_SECURE=false

# CORS (frontend origin'leri)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis
REDIS_URL=redis://localhost:6379/0

# Centrifugo
CENTRIFUGO_API_URL=http://localhost:8000/api
CENTRIFUGO_API_KEY=dev-centrifugo-api-key
CENTRIFUGO_HMAC_SECRET=dev-centrifugo-hmac-secret

# OpenAI Agent
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-4o-mini

# X (Twitter) API - GERCEK CAGRI YAPILMAZ, sadece stub icin
X_API_BEARER_TOKEN=
X_API_BASE_URL=https://api.x.com/2

# Higgsfield - GERCEK CAGRI YAPILMAZ, sadece stub icin
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_BASE_URL=https://api.higgsfield.ai

# Procrastinate (opsiyonel)
PROCRASTINATE_ENABLED=false

# Monitoring
SENTRY_DSN=

# ML Model Artifacts
# Production'da model bundle harici artifact storage / GitHub Release
# gibi bir kaynaktan indirilebilir.
MODEL_BUNDLE_URL=https://github.com/ikrabaser/disinfo-detection-platform/releases/download/models-v1/veritas-models-v1.tar.gz
MODEL_BUNDLE_SHA256=a96e8b35c61721c97b21430b47947dbfac1060f2582062845df9dd4f66cae879
MODEL_ARTIFACTS_REQUIRED=false
