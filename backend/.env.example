# Django
DJANGO_SECRET_KEY=insecure-dev-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Veritabani (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dezenformasyon_db

# JWT / cookie
JWT_COOKIE_SECURE=false

# CORS (frontend origin'leri)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis
REDIS_URL=redis://localhost:6379/0

# Centrifugo
CENTRIFUGO_API_URL=http://localhost:8000/api
CENTRIFUGO_API_KEY=dev-centrifugo-api-key
CENTRIFUGO_HMAC_SECRET=dev-only-centrifugo-hmac-secret-change-me-0123456789abcdef
CENTRIFUGO_TOKEN_TTL_SECONDS=300

# LLM Providers
DEFAULT_LLM_PROVIDER=openai
ASSISTANT_HISTORY_MESSAGES=20
AGENT_MAX_TOOL_STEPS=4

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# RAG / Embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

RAG_CHUNK_TOKENS=600
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.35

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=2048

# EVREN
EVREN_API_KEY=
EVREN_BASE_URL=
EVREN_CHAT_MODEL=

# Evidence Retrieval

# Google Fact Check Tools API
# Bos birakilirsa sistem GDELT ile devam eder.
GOOGLE_FACT_CHECK_API_KEY=
GOOGLE_FACT_CHECK_LANGUAGE=

# GDELT DOC 2.0
GDELT_DOC_API_URL=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_TIMESPAN=3months

EVIDENCE_HTTP_TIMEOUT_SECONDS=10

# Safe article content extraction
ARTICLE_FETCH_MAX_BYTES=1500000
ARTICLE_FETCH_MAX_REDIRECTS=3
ARTICLE_CONTENT_MIN_CHARS=200

# X (Twitter) API - GERCEK CAGRI YAPILMAZ, sadece stub icin
X_API_BEARER_TOKEN=
X_API_BASE_URL=https://api.x.com/2

# Higgsfield - GERCEK CAGRI YAPILMAZ, sadece stub icin
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_BASE_URL=https://api.higgsfield.ai

# Procrastinate (opsiyonel)
PROCRASTINATE_ENABLED=false

# Monitoring
SENTRY_DSN=

# ML Model Artifacts
# Production'da model bundle harici artifact storage / GitHub Release
# gibi bir kaynaktan indirilebilir.
MODEL_BUNDLE_URL=https://github.com/ikrabaser/disinfo-detection-platform/releases/download/models-v1/veritas-models-v1.tar.gz
MODEL_BUNDLE_SHA256=a96e8b35c61721c97b21430b47947dbfac1060f2582062845df9dd4f66cae879
MODEL_ARTIFACTS_REQUIRED=false
